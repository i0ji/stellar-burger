{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* ------------------ Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* ------------------ Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* ------------------ Alias */
    "paths": {
      /* ------ MAIN */
      "store/*": ["./src/store/*"],
      "components/*": ["./src/components/*"],

      "common/*": ["./src/components/common/*"],

      /* ------ MODAL */
      "modal/*": ["./src/components/Modal/*"],

      /* ------ PAGES */
      "pages/*": ["./src/pages/*"],
      "profile/*": ["./src/pages/ProfilePage/*"],
      "ingredients/*": ["./src/pages/IngredientDetailsPage/*"],
      "orders/*": ["./src/pages/OrderDetailsPage/*"],

      /* ------ HOOK */
      "hooks/*": ["./src/services/hooks/*"],

      /* ------ STYLES/ASSETS */
      "styles/*": ["./src/styles/*"],
      "images/*": ["./src/images/*"],

      /* ------ UTILS/SERVICES */
      "services/*": ["./src/services/*"],
      "utils/*": ["./src/services/utils/*"],
      "slices/*": ["./src/services/slices/*"],
      "declarations/*": ["./src/services/declarations/*"]
    }
  },
  "include": ["src"],
  "files": ["vite.config.ts"]
}
